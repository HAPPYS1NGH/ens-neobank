# Copy to .env.local. Server-only — nothing here is NEXT_PUBLIC_.

# Namespace API key for the parent below. https://dev.namespace.ninja
NAMESPACE_API_KEY=

# The ENS parent you own and issue subnames under.
# Must appear in ALLOWED_PARENTS in src/server/config.ts or the server refuses to start.
NAMESPACE_PARENT_NAME=tange.eth

# mainnet | sepolia
NAMESPACE_NETWORK=mainnet

# Public Ethereum RPC used to resolve names OUTSIDE our own parent
# (vitalik.eth, someone.id, …) through standard ENS with CCIP-Read.
ENS_RPC_URL=https://ethereum-rpc.publicnode.com
