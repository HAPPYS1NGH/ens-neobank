# Copy to .env.local. Everything here is server-only except the display parent.

# Namespace API key for the parent below. https://dev.namespace.ninja
NAMESPACE_API_KEY=

# The ENS parent you own and issue subnames under.
# Must appear in registry.allowedParents in app.config.ts or the server refuses to start.
NAMESPACE_PARENT_NAME=ninza.eth

# mainnet | sepolia
NAMESPACE_NETWORK=mainnet

# Public Ethereum RPC used to resolve names OUTSIDE our own parent
# (vitalik.eth, someone.id, …) through standard ENS with CCIP-Read.
ENS_RPC_URL=https://ethereum-rpc.publicnode.com

# The one client-side variable. Display-only parent the UI shows in names
# (label.<parent>). Set it to match the parent above.
NEXT_PUBLIC_DISPLAY_PARENT=ninza.eth
