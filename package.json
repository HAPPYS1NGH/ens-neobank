{
  "name": "ninza",
  "private": true,
  "version": "0.1.0",
  "description": "Starter kit for mobile wallet demos that issue gasless offchain ENS subnames at wallet creation, write per-chain address records, and resolve names on send.",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "typecheck": "tsc --noEmit",
    "cleanup": "node scripts/cleanup-demo-names.mjs",
    "check:secrets": "node scripts/check-client-boundary.mjs",
    "shots": "node shots/capture.mjs"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "1.1.4",
    "@noble/curves": "^1.9.1",
    "@noble/hashes": "^1.8.0",
    "@scure/base": "^1.2.6",
    "@thenamespace/offchain-manager": "^1.0.13",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "playwright": "1.62.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
